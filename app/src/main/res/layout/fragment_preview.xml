<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <!-- Header with Back Button and Title -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_split"
        android:rotation="90"
        app:tint="@color/text_pure_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_preview_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/preview_title"
        android:textColor="@color/text_pure_white"
        android:textSize="26sp"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />

    <!-- Preview Glass Card with File Information and Watermark Badge -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_card"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/layout_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_preview_title">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iv_file_type"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_image_to_pdf"
                app:tint="@color/electric_cyan"
                app:layout_constraintBottom_toTopOf="@id/tv_filename"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tv_filename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Output_Document.pdf"
                android:textColor="@color/text_pure_white"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@id/tv_filesize"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_file_type" />

            <TextView
                android:id="@+id/tv_filesize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="420 KB • 100% Offline"
                android:textColor="@color/text_light_grey"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@id/chip_watermark_status"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_filename" />

            <!-- Watermark Indicator Badge -->
            <TextView
                android:id="@+id/chip_watermark_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Watermark: Active"
                android:textColor="@color/electric_cyan"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_filesize" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/banner_ad_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Remove Watermark Button (Rewarded Ad) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remove_watermark"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_glass_card"
            android:fontFamily="sans-serif-bold"
            android:text="@string/action_remove_watermark"
            android:textColor="@color/electric_cyan"
            android:textSize="14sp"
            app:backgroundTint="@null"
            app:cornerRadius="24dp"
            app:strokeColor="@color/electric_cyan"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:fontFamily="sans-serif-bold"
                android:text="@string/action_share"
                android:textColor="@color/text_pure_white"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gradient_button"
                android:fontFamily="sans-serif-bold"
                android:text="@string/action_save"
                android:textColor="@color/text_pure_white"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- AdMob Test Banner Container -->
    <FrameLayout
        android:id="@+id/banner_ad_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
